# PostgreSQL Database Connection String
# Format: postgresql://user:password@localhost:5432/database_name
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/infp_cms"

# JWT Secret for authentication
JWT_SECRET="your-jwt-secret"

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="your-supabase-project-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"

# WeChat Configuration (optional)
WECHAT_APPID="your-wechat-appid"
WECHAT_SECRET="your-wechat-secret"

# Password Encryption Salt
# Used for client-side SHA-256 hashing before transmission
# IMPORTANT: Change this to a strong random string in production!
NEXT_PUBLIC_PASSWORD_SALT="infp-cms-fixed-salt-2024"

# DeepSeek API Configuration
# Get your API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"